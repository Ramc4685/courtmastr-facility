# Copy to .env.local (git-ignored). Dev values only.
# API origin: http://localhost:<FH_API_PORT> from the repo .env. The tenant travels in the X-Tenant-Slug
# header (the simulator cannot resolve *.localhost), and signed-in calls take it from the token.
EXPO_PUBLIC_API_ORIGIN=http://localhost:8100
# Production: set the platform domain and the app calls https://<tenant-slug>.<domain>/api/v1 instead.
# EXPO_PUBLIC_PLATFORM_DOMAIN=
# Member web portal origin (https) for tell-a-friend links; defaults to https://<platform domain> when set.
# EXPO_PUBLIC_WEB_ORIGIN=
# "api" (default) calls the real member-portal API. "demo" uses in-memory demo data, labelled on every screen.
EXPO_PUBLIC_PORTAL_ADAPTER=api
