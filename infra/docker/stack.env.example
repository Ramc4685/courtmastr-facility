# Throwaway values for the local container stack only. `make stack-up` writes infra/docker/.env.stack (git-ignored)
# from this file, generating FH_DATA_KEY and FH_OPERATOR_TOKEN: the stack runs as FH_ENV=stack, which (like production) refuses
# dev or example values for those two. An .env.stack made before that still holds the old example key: delete it.
# Never reuse any of these anywhere else; a real deployment generates its own and keeps them in the host's secret store.
FH_POSTGRES_PASSWORD=stack-postgres-superuser
FH_DB_OWNER_PASSWORD=stack-owner-password
FH_DB_APP_PASSWORD=stack-app-password
FH_DB_PLATFORM_PASSWORD=stack-platform-password
FH_OPERATOR_TOKEN=generated-by-make
# AES-256-GCM key, base64 of 32 random bytes (openssl rand -base64 32); generated by make, empty is refused
FH_DATA_KEY=
FH_S3_ACCESS_KEY_ID=stack-s3-key
FH_S3_SECRET_ACCESS_KEY=stack-s3-secret-key
# Backups (infra/backup): the passphrase that encrypts dumps at rest.
FH_BACKUP_PASSPHRASE=stack-backup-passphrase
# Host ports (all bound to 127.0.0.1). The HTTPS port must match app.web_base_url in config/app.stack.yaml.
FH_STACK_HTTP_PORT=18080
FH_STACK_HTTPS_PORT=18443
FH_STACK_S3_PORT=19000
FH_STACK_MAIL_UI_PORT=18025
