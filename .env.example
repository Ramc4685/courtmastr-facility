# Dev-only defaults. Copy to .env (make does this). Never reuse these values outside local development.
FH_ENV=dev
FH_POSTGRES_PASSWORD=dev-postgres-superuser
FH_DB_OWNER_PASSWORD=dev-owner-password
FH_DB_APP_PASSWORD=dev-app-password
FH_DB_PLATFORM_PASSWORD=dev-platform-password
# Guards POST /api/v1/operator/tenants (tenant onboarding). Empty disables the endpoint.
FH_OPERATOR_TOKEN=dev-operator-token
# AES-256-GCM key (base64, 32 bytes) for replayable tenant secrets such as webhook signing keys. Unset in dev and
# test uses a built-in dev key; required everywhere else.
# FH_DATA_KEY=
# Lane isolation for parallel checkouts (optional; defaults: facilityhub, facilityhub_test, 8100, 5183).
# Set all four in a lane's .env, then run `make lane-db`.
# FH_DB_NAME=facilityhub_space
# FH_TEST_DB_NAME=facilityhub_test_space
# FH_API_PORT=8110
# FH_WEB_PORT=5193
