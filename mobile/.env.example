# Copy to .env.local (git-ignored). Dev values only.
# API origin. In development the tenant travels in the X-Tenant-Slug header.
EXPO_PUBLIC_API_ORIGIN=http://localhost:8150
# Production: set the platform domain and the app calls https://<tenant-slug>.<domain>/api/v1 instead.
# EXPO_PUBLIC_PLATFORM_DOMAIN=
# Portal surfaces not yet on main (bookings, memberships, billing, inbox, devices, cards, app-config,
# directory): "demo" uses the in-app demo data, labelled on every screen; "api" calls the planned endpoints.
EXPO_PUBLIC_PORTAL_ADAPTER=demo
