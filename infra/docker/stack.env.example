# Throwaway values for the local container stack only. Copy to infra/docker/.env.stack (git-ignored).
# Never reuse any of these anywhere else; a real deployment generates its own and keeps them in the host's secret store.
FH_POSTGRES_PASSWORD=stack-postgres-superuser
FH_DB_OWNER_PASSWORD=stack-owner-password
FH_DB_APP_PASSWORD=stack-app-password
FH_DB_PLATFORM_PASSWORD=stack-platform-password
FH_OPERATOR_TOKEN=stack-operator-token
# AES-256-GCM key, base64 of 32 random bytes: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FH_DATA_KEY=VwpXfRnSkcoF5/q6HdE+0q6UoYCTPLxCXfp2XaacPsw=
FH_S3_ACCESS_KEY_ID=stack-s3-key
FH_S3_SECRET_ACCESS_KEY=stack-s3-secret-key
# Backups (infra/backup): the passphrase that encrypts dumps at rest.
FH_BACKUP_PASSPHRASE=stack-backup-passphrase
# Host ports (all bound to 127.0.0.1). The HTTPS port must match app.web_base_url in config/app.production.yaml.
FH_STACK_HTTP_PORT=18080
FH_STACK_HTTPS_PORT=18443
FH_STACK_S3_PORT=19000
FH_STACK_MAIL_UI_PORT=18025
